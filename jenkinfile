pipeline {
    agent any

    stages {
        // Étape 1 : Compilation du projet
        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }

        // Étape 2 : Exécution des tests unitaires JUnit
        stage('Run JUnit Tests') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'  // Collecte des rapports de tests
                }
                failure {
                    echo "❌ Tests unitaires échoués ! Arrêt du pipeline."
                    error("Tests unitaires échoués.")  // Arrête le pipeline si les tests échouent
                }
            }
        }

        // Étape 3 : Analyse SonarQube
        stage('MVN Sonarqube') {
            steps {
                sh 'mvn sonar:sonar -Dsonar.login=squ_9cf9850fd06e499c5d1600a4aba4595c5c767100 -Dmaven.test.skip=true'
            }
        }

        // Étape 4 : Installation du projet
        stage('Install') {
            steps {
                sh 'mvn clean install -Dmaven.test.skip=true'
            }
        }

        // Étape 5 : Déploiement sur Nexus
        stage('MVN Nexus') {
            steps {
                sh 'mvn deploy -Dmaven.test.skip=true'
            }
        }

        // Étape 6 : Construction des images Docker
        stage('Build Docker Images') {
            steps {
                sh 'docker-compose build'
            }
        }

        // Étape 7 : Authentification à Docker Hub
        stage('Login to DockerHub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                        sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                    }
                }
            }
        }

        // Étape 8 : Pousser les images Docker vers Docker Hub
        stage('Push Docker Image') {
            steps {
                sh 'docker-compose push'
            }
        }

        // Étape 9 : Déploiement avec Docker Compose
        stage('Deploy with Docker Compose') {
            steps {
                sh 'docker-compose up -d'
            }
        }

        // Étape 10 : Exposition avec Ngrok
stage('Expose with Ngrok') {
    steps {
        script {
            // Print current working directory (for debugging)
            sh 'pwd'
            
            // Start ngrok with output logged into an absolute path
            sh 'nohup ngrok http 8089 > $WORKSPACE/ngrok.log 2>&1 &'
            
            // Wait to ensure Ngrok has enough time to fully initialize
            sleep 15
            
            // Capture the entire Ngrok API response
            def ngrokApiResp = sh(script: "curl -s http://localhost:4040/api/tunnels", returnStdout: true).trim()
            echo "Ngrok API response: ${ngrokApiResp}"
            
            // Parse the public URL using jq
            def ngrokUrl = sh(script: "echo '${ngrokApiResp}' | jq -r '.tunnels[0].public_url'", returnStdout: true).trim()
            echo "🚀 Ngrok tunnel is running at: ${ngrokUrl}"
            
            // Optionally save the URL to a file for later use
            sh "echo '${ngrokUrl}' > $WORKSPACE/ngrok_url.txt"
        }
    }
}


        // Étape 11 : Vérification des métriques Prometheus
        stage('Test Prometheus Metrics') {
            steps {
                script {
                    def prometheus_url = 'http://192.168.152.129:9090/api/v1/query'
                    def query = 'up{job="spring-boot-application"}'
                    def response = sh(script: "curl -s '${prometheus_url}?query=${URLEncoder.encode(query, "UTF-8")}'", returnStdout: true)
                    echo "Prometheus Response: ${response}"
                }
            }
        }

        // Étape 12 : Vérification du déploiement
        stage('Verify Deployment') {
            steps {
                script {
                    retry(5) {
                        sleep 10
                        sh 'curl -I http://192.168.152.129:8089/kaddem'
                    }
                }
            }
        }
    }

    post {
        always {
            mail (
                subject: "TEST: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    This is a test email from Jenkins.
                    Build: ${env.BUILD_URL}
                    Status: ${currentBuild.result ?: 'UNKNOWN'}
                """,
                to: 'firasbessalahboos@gmail.com'
            )
        }
    }
}

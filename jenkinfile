pipeline {
    agent none
    
    stages {
        // Stage 1: Compile on master (Linux)
        stage('Compile (Master)') {
            agent { label 'master' }
            steps {
                echo "Running on ${env.NODE_NAME} (Labels: ${env.NODE_LABELS})"
                sh 'mvn clean compile'
            }
        }
        
        // Stage 2: Windows tests on esprit
        stage('Windows Tests (Esprit)') {
            agent { label 'esprit' }
            steps {
                echo "Running on ${env.NODE_NAME} (Labels: ${env.NODE_LABELS})"
                bat 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
                failure {
                    error("Windows tests failed on esprit slave")
                }
            }
        }
        
        // Stage 3: SonarQube analysis on master
        stage('SonarQube (Master)') {
            agent { label 'master' }
            steps {
                echo "Running on ${env.NODE_NAME}"
                sh 'mvn sonar:sonar -Dsonar.login=squ_9cf9850fd06e499c5d1600a4aba4595c5c767100 -Dmaven.test.skip=true'
            }
        }
        
        // Stage 4: Windows build on esprit
        stage('Windows Build (Esprit)') {
            agent { label 'esprit' }
            steps {
                bat 'mvn clean install -Dmaven.test.skip=true'
            }
        }
        
        // Stage 5: Nexus deploy on master
        stage('Nexus Deploy (Master)') {
            agent { label 'master' }
            steps {
                sh 'mvn deploy -Dmaven.test.skip=true'
            }
        }
        
        // Stage 6: Windows verification on esprit
        stage('Windows Verification (Esprit)') {
            agent { label 'esprit' }
            steps {
                bat 'systeminfo'
                bat 'java -version'
            }
        }
        
        // Stage 7: Docker operations on master
        stage('Docker Build (Master)') {
            agent { label 'master' }
            steps {
                sh 'docker-compose build'
            }
        }
        
        // Stage 8: Windows artifacts check on esprit
        stage('Artifacts Check (Esprit)') {
            agent { label 'esprit' }
            steps {
                bat 'dir target\\*'
            }
        }
        
        // Stage 9: Docker push on master
        stage('Docker Push (Master)') {
            agent { label 'master' }
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'docker-hub-credentials', 
                        usernameVariable: 'DOCKER_USERNAME', 
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                        sh 'docker-compose push'
                    }
                }
            }
        }
        
        // Stage 10: Final deployment on master
        stage('Deploy (Master)') {
            agent { label 'master' }
            steps {
                sh 'docker-compose up -d'
                
                // Verification
                retry(5) {
                    sleep 10
                    def status = sh(
                        script: 'curl -s -o /dev/null -w "%{http_code}" http://192.168.152.129:8089/kaddem',
                        returnStdout: true
                    ).trim()
                    
                    if (status != "200") {
                        error("Deployment verification failed. HTTP Status: ${status}")
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo "Pipeline completed"
            echo "Master node executions: ${currentBuild.rawBuild.getActions(hudson.plugins.sidebar__link.ProjectSidebarLinkAction).size()}"
            echo "Esprit node executions: ${currentBuild.rawBuild.getActions(hudson.plugins.sidebar__link.BuildSidebarLinkAction).size()}"
        }
        success {
            echo "SUCCESS: Alternating master/esprit execution completed"
        }
        failure {
            echo "FAILURE: Pipeline failed at stage ${currentBuild.currentResult}"
        }
    }
}

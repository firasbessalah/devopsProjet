pipeline {
    agent none
    
    environment {
        // Shared environment variables
        ARTIFACT_DIR = 'target'
        DEPLOYMENT_URL = 'http://192.168.152.129:8089/kaddem'
        PROMETHEUS_URL = 'http://192.168.152.129:9090/api/v1/query'
    }
    
    stages {
        /* ========== MASTER NODE STAGES (Linux) ========== */
        stage('1. Compile (Master)') {
            agent { label 'master' }
            steps {
                echo "🚀 Starting master sequence on ${env.NODE_NAME}"
                sh 'mvn clean compile'
                archiveArtifacts artifacts: '${ARTIFACT_DIR}/**/*', allowEmptyArchive: true
            }
        }
        
        /* ========== ESPRIT NODE STAGES (Windows) ========== */
        stage('2. Unit Tests (Esprit)') {
            agent { label 'esprit' }
            steps {
                echo "🖥️ Starting esprit sequence on ${env.NODE_NAME}"
                bat 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
                failure {
                    error("❌ Unit tests failed on esprit")
                }
            }
        }
        
        stage('3. Code Analysis (Master)') {
            agent { label 'master' }
            steps {
                sh 'mvn sonar:sonar -Dsonar.login=squ_9cf9850fd06e499c5d1600a4aba4595c5c767100 -Dmaven.test.skip=true'
            }
        }
        
        stage('4. Package (Esprit)') {
            agent { label 'esprit' }
            steps {
                bat 'mvn clean package -DskipTests'
                bat 'dir /s ${ARTIFACT_DIR}'
            }
        }
        
        stage('5. Deploy to Nexus (Master)') {
            agent { label 'master' }
            steps {
                sh 'mvn deploy -DskipTests'
            }
        }
        
        stage('6. System Check (Esprit)') {
            agent { label 'esprit' }
            steps {
                bat 'systeminfo | findstr /C:"OS Name" /C:"OS Version"'
                bat 'java -version'
                bat 'mvn -v'
            }
        }
        
        /* ========== DOCKER OPERATIONS (Master only) ========== */
        stage('7. Docker Build (Master)') {
            agent { label 'master' }
            steps {
                sh 'docker-compose build --no-cache'
            }
        }
        
        stage('8. Artifact Validation (Esprit)') {
            agent { label 'esprit' }
            steps {
                bat 'powershell "Get-ChildItem ${env:ARTIFACT_DIR} -Recurse | Select-Object Name, Length"'
            }
        }
        
        stage('9. Docker Publish (Master)') {
            agent { label 'master' }
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'docker-hub-credentials', 
                        usernameVariable: 'DOCKER_USERNAME', 
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh '''
                            echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                            docker-compose push
                        '''
                    }
                }
            }
        }
        
        /* ========== DEPLOYMENT & VERIFICATION ========== */
        stage('10. Deploy & Verify (Master)') {
            agent { label 'master' }
            steps {
                script {
                    sh 'docker-compose up -d'
                    
                    // Health check with retry logic
                    def attempts = 5
                    def waitTime = 10
                    def status = ''
                    
                    for (int i = 0; i < attempts; i++) {
                        try {
                            status = sh(
                                script: "curl -s -o /dev/null -w '%{http_code}' ${DEPLOYMENT_URL}",
                                returnStdout: true
                            ).trim()
                            
                            if (status == "200") {
                                echo "✅ Deployment successful (HTTP 200)"
                                break
                            }
                        } catch (Exception e) {
                            echo "⚠️ Attempt ${i+1}/${attempts} failed"
                        }
                        sleep(waitTime)
                    }
                    
                    if (status != "200") {
                        error("Deployment failed. Final status: ${status}")
                    }
                    
                    // Verify Prometheus metrics
                    def prometheusResponse = sh(
                        script: "curl -s '${PROMETHEUS_URL}?query=up{job=\"spring-boot-application\"}'",
                        returnStdout: true
                    )
                    
                    if (!prometheusResponse.contains('"status":"success"')) {
                        error("Prometheus monitoring check failed")
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo "📊 Pipeline Execution Summary"
            echo "--------------------------"
            echo "Master Node: ${env.NODE_NAME}" 
            echo "Esprit Node: ${currentBuild.buildVariables.NODE_NAME}"
            echo "Total Duration: ${currentBuild.durationString}"
            
            // Cleanup Docker resources if pipeline failed
            script {
                if (currentBuild.result == 'FAILURE') {
                    echo "⚠️ Performing cleanup..."
                    sh 'docker-compose down || true'
                }
            }
        }
        
        success {
            slackSend(
                color: 'good',
                message: "SUCCESS: Pipeline ${env.JOB_NAME} #${env.BUILD_NUMBER}\n" +
                         "Nodes: master & esprit\n" +
                         "Duration: ${currentBuild.durationString}"
            )
        }
        
        failure {
            slackSend(
                color: 'danger',
                message: "FAILED: Pipeline ${env.JOB_NAME} #${env.BUILD_NUMBER}\n" +
                         "Failed Stage: ${currentBuild.currentResult}\n" +
                         "View logs: ${env.BUILD_URL}console"
            )
        }
        
        cleanup {
            echo "🧹 Cleaning up workspace..."
            deleteDir()
        }
    }
}

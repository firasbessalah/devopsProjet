pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test -Dspring.profiles.active=test'
            }
        }
        stage('Sonar Analysis') {
            steps {
                withSonarQubeEnv('sq1') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('Nexus') {
            steps {
                sh 'mvn deploy -DskipTests'
            }
        }
        stage('Docker Build') {
                  steps {
                      script {
                          // Verify JAR file exists
                          sh 'ls -la target/*.jar'

                          // Update Dockerfile base image
                          sh "sed -i 's|openjdk:11-jdk-alpine|eclipse-temurin:11-jdk-alpine|g' Dockerfile"

                          // Build Docker image
                          sh 'docker build --network=host -t kaddem-app:latest .'

                          // Tag the image for DockerHub
                          sh 'docker tag kaddem-app:latest sfaxioussama/kaddem-app:1.0.0'
                      }
                  }
              }
              stage('Push to DockerHub') {
                  steps {
                      script {
                          // Use Jenkins credentials to login to DockerHub
                          withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                         usernameVariable: 'DOCKER_HUB_USER',
                                                         passwordVariable: 'DOCKER_HUB_PWD')]) {
                              sh 'echo $DOCKER_HUB_PWD | docker login -u $DOCKER_HUB_USER --password-stdin'
                              sh 'docker push sfaxioussama/kaddem-app:1.0.0'
                          }
                      }
                  }
              }
   stage('Deploy') {
             steps {
                 script {
                     // Solution robuste sans docker-compose
                     sh '''
                         # Arrêt des conteneurs existants
                         docker stop timesheet-app timesheet-mysql || true
                         docker rm timesheet-app timesheet-mysql || true

                         # Création du réseau si inexistant
                         docker network create timesheet-net || true

                         # Démarrage MySQL avec attente explicite
                         docker run -d --name timesheet-mysql \\
                             --network timesheet-net \\
                             -e MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD} \\
                             -e MYSQL_DATABASE=timesheet_db \\
                             -p 3306:3306 \\
                             -v mysql_data:/var/lib/mysql \\
                             --health-cmd="mysqladmin ping -uroot -p${MYSQL_ROOT_PASSWORD}" \\
                             --health-interval=10s \\
                             --health-timeout=5s \\
                             --health-retries=3 \\
                             mysql:5.7

                         # Attente que MySQL soit healthy
                         timeout 180s bash -c 'while [[ $(docker inspect -f "{{.State.Health.Status}}" timesheet-mysql) != "healthy" ]]; do sleep 5; done'

                         # Démarrage de l'application
                         docker run -d --name timesheet-app \\
                             --network timesheet-net \\
                             -p 8082:8082 \\
                             -e SPRING_DATASOURCE_URL=jdbc:mysql://timesheet-mysql:3306/timesheet_db \\
                             -e SPRING_DATASOURCE_USERNAME=root \\
                             -e SPRING_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD} \\
                             ${DOCKER_IMAGE}:latest
                     '''
                 }
             }
         }
     }
     post {
         always {
             cleanWs()
             // Notification email alternative
             script {
                 currentBuild.result = currentBuild.result ?: 'SUCCESS'
                 emailext (
                     subject: "${currentBuild.result}: Job ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                     body: """
                         Build: ${env.JOB_NAME} - #${env.BUILD_NUMBER}
                         Status: ${currentBuild.result}
                         URL: ${env.BUILD_URL}
                         Image: ${DOCKER_IMAGE}:${DOCKER_TAG}
                     """,
                     to: 'devops@example.com'
                 )
             }
         }
     }
 }


pipeline {
    agent any
     environment {
            // Configuration des variables d'environnement
            DOCKER_REGISTRY = 'docker.io'
            DOCKER_IMAGE = 'sfaxioussama/kaddem-app'
            DOCKER_TAG = "${env.BUILD_NUMBER}"
            NEXUS_URL = 'http://nexus.yourcompany.com:8081'
        }
    stages {
           // Étape 1: Build
           stage('Build') {
               steps {
                   sh 'mvn clean compile'
               }
           }

           // Étape 2: Tests
           stage('Test') {
               steps {
                   sh 'mvn test -Dspring.profiles.active=test'
               }
           }

           // Étape 3: Analyse SonarQube
           stage('Sonar Analysis') {
               steps {
                   withSonarQubeEnv('sq1') {
                       sh 'mvn sonar:sonar'
                   }
               }
           }

           // Étape 4: Déploiement Nexus
           stage('Nexus') {
               steps {
                   sh 'mvn deploy -DskipTests'
               }
           }

           // Étape 5: Construction Docker
           stage('Docker Build') {
               steps {
                   script {
                       // Modification du Dockerfile si nécessaire
                       sh "sed -i 's|openjdk:11-jdk-alpine|eclipse-temurin:11-jdk-alpine|g' Dockerfile"

                       // Construction de l'image avec host networking
                       sh "docker build --network=host -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                   }
               }
           }

           // Étape 6: Push Docker
           stage('Docker Push') {
               steps {
                   script {
                       // Utilisation des credentials Jenkins pour Docker Hub
                       withCredentials([usernamePassword(
                           credentialsId: 'docker-hub-creds',
                           usernameVariable: 'DOCKER_USER',
                           passwordVariable: 'DOCKER_PWD'
                       )]) {
                           sh "docker login -u ${DOCKER_USER} -p ${DOCKER_PWD}"
                           sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                       }
                   }
               }
           }
       }

       post {
           always {
               // Nettoyage des images Docker locales
               sh 'docker system prune -f'
           }
           success {
               // Notification de succès
               slackSend channel: '#devops',
                        color: 'good',
                        message: "Build réussi: ${env.JOB_NAME} - ${env.BUILD_NUMBER}"
           }
           failure {
               // Notification d'échec
               slackSend channel: '#devops',
                        color: 'danger',
                        message: "Échec du build: ${env.JOB_NAME} - ${env.BUILD_NUMBER}"
           }
       }
   }
pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'sfaxioussama/kaddem-app'
        DOCKER_TAG = '1.0.0'
    }
    stages {
        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test -Dspring.profiles.active=test'
            }
        }
        stage('Sonar Analysis') {
            steps {
                withSonarQubeEnv('sq1') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('Nexus') {
            steps {
                sh 'mvn deploy -DskipTests'
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    // Verify JAR file exists
                    sh 'ls -la target/*.jar'
                    // Update Dockerfile base image (if needed, but already correct in this case)
                    sh "sed -i 's|openjdk:11-jdk-alpine|eclipse-temurin:11-jdk-alpine|g' Dockerfile"
                    // Build Docker image
                    sh 'docker build --network=host -t kaddem-app:latest .'
                    // Tag the image for DockerHub
                    sh 'docker tag kaddem-app:latest sfaxioussama/kaddem-app:1.0.0'
                }
            }
        }
        stage('Push to DockerHub') {
            steps {
                script {
                    // Use Jenkins credentials to login to DockerHub
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                      usernameVariable: 'DOCKER_HUB_USER',
                                                      passwordVariable: 'DOCKER_HUB_PWD')]) {
                        sh 'echo $DOCKER_HUB_PWD | docker login -u $DOCKER_HUB_USER --password-stdin'
                        sh 'docker push sfaxioussama/kaddem-app:1.0.0'
                    }
                }
            }
        }
        stage('Deploy with Docker Compose') {
            steps {
                script {
                    // Use Docker Compose via Docker container
                    sh 'docker run --rm -v $(pwd):/app -w /app docker/compose:latest up -d'
                }
            }
        }
    }
}